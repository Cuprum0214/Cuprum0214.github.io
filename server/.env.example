# ---------------------------------------------------------------------------
# Cuprum 数字人 · 后端配置模板
# 复制为 server/.env 后填入真实值。本文件（含 .env）不要放入 outputs/，不要外传。
# ---------------------------------------------------------------------------

# 上游模型服务（OpenAI 兼容协议）
# DeepSeek   https://api.deepseek.com
# 通义百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM   https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama http://127.0.0.1:11434/v1
UPSTREAM_BASE=https://api.deepseek.com

# 模型名：deepseek-chat（通用对话） / deepseek-reasoner（推理，回复较慢）
MODEL=deepseek-chat

# API Key —— 只有这一处需要你填写
API_KEY=

# 监听地址（保持 127.0.0.1 表示仅本机可访问；若要局域网访问改成 0.0.0.0）
HOST=127.0.0.1
PORT=8145

# 生成参数
TEMPERATURE=0.7
MAX_TOKENS=700

# 上下文与限制
MAX_TURNS=8
TIMEOUT=60
RATE_PER_MIN=30
MAX_BODY=65536
PROMPT_LIMIT=6000

# ---------------------------------------------------------------------------
# 反馈箱（访客留言 → 只有你能查看与回复）
# ---------------------------------------------------------------------------
# 主页所有者口令：在页面「反馈箱 → 所有者」里输入它即可查看/回复留言。
# 建议用一串随机字符（例如：python -c "import secrets;print(secrets.token_urlsafe(12))"）
OWNER_TOKEN=
# 同一 IP 每分钟最多留言几条（0 = 不限）
FEEDBACK_PER_MIN=8
# 回复接口每分钟上限（所有者自用，给宽一点）
REPLY_PER_MIN=120
# 留言最多存几条，超出丢弃最旧的
FB_MAX_ITEMS=500
# 允许跨域来源：同源部署保持 *；页面在 GitHub Pages、后端在别处时可填 Pages 域名
ALLOW_ORIGIN=*
